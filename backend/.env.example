# Copy to .env (never commit .env)
GEMINI_API_KEY=
# Run `python scripts/check_llm.py` to list models your key can use, then paste one here.
GEMINI_MODEL=
# Groq (free tier) - optional second provider. Get a key at console.groq.com
GROQ_API_KEY=
GROQ_MODEL=
# auto = Gemini first, Groq as fallback | gemini | groq
LLM_PROVIDER=auto
SUPABASE_URL=
SUPABASE_ANON_KEY=
FRONTEND_URL=http://localhost:3000
# Optional overrides
# OVERPASS_URLS=comma,separated,list   (defaults are fine)
# Use your real email, e.g. TripPilotAI/0.1 (name@gmail.com)
NOMINATIM_USER_AGENT=TripPilotAI/0.1 (name@example.com)

# Optional: send trip events to n8n (see docs/n8n.md). Leave empty to disable.
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
